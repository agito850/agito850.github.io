---
import { getCollection } from "astro:content";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

const entries = await getCollection("posts_en", ({ data }) => import.meta.env.PROD ? data.draft !== true : true);
entries.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<MainGridLayout title="Home" description="Shon's tech sandbox">
    <div class="flex flex-col gap-4 w-full">
        {entries.map((entry) => (
            <a href={`/en/posts/${entry.slug}/`} class="card-base z-10 px-6 md:px-9 py-6 relative w-full block active:scale-[0.99] transition">
                <h2 class="text-2xl md:text-3xl font-bold text-90 mb-2
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[1.9rem] before:left-[0.75rem] md:before:left-[1.25rem]">
                    {entry.data.title}
                </h2>
                <div class="flex gap-3 items-center text-black/60 dark:text-white/60 text-sm mb-2">
                    <span>{formatDateToYYYYMMDD(entry.data.published)}</span>
                    {entry.data.category && <span>· {entry.data.category}</span>}
                    {entry.data.tags && entry.data.tags.length > 0 && <span>· {entry.data.tags.join(" / ")}</span>}
                </div>
                <p class="text-black/70 dark:text-white/70">{entry.data.description}</p>
            </a>
        ))}
    </div>
</MainGridLayout>
